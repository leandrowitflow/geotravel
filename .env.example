# Database access is via Supabase PostgREST (HTTPS). No DATABASE_URL / direct Postgres port is required.
#
# Local development: copy to `.env.local` (gitignored). Next.js loads `.env.local` with higher priority
# than `.env`; use `.env.local` for secrets — do not commit it.

# Supabase — https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# “anon” / “publishable” client key (sb_publishable_… is OK here). Never use the service_role key in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for ingest, webhooks, cron, admin DB queries, and scripts (db:check / db:seed).
# Never expose this in client bundles or the browser.
SUPABASE_SERVICE_ROLE_KEY=
# If your tooling only sets a publishable default name, the app also reads (optional):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Comma-separated emails that may access admin when metadata roles are not set yet
ADMIN_BOOTSTRAP_EMAILS=

# Geotravel Data API — docs: https://geotraveldata.com/api-docs
# One key per external client. Set in Vercel env vars for production.
GEOTRAVEL_API_KEY=
# When "1" or "true", admin booking confirm sends SMS only (skips Meta). Omit when testing WhatsApp templates.
# GEOTRAVEL_BOOKING_CONFIRM_FORCE_SMS=1
# Optional. Max rows walked for ref-only client scans and for phone+ref (phone-filtered pages). Phone-only search uses one request per page via passenger_phone. Default 12000, max 200000.
# GEOTRAVEL_MAX_SCAN_ROWS=12000
# Optional. Comma-separated digit substrings; passenger_phone (digits only) must include one to show “WhatsApp confirm” on a booking row. Built-in defaults include 966915976, +351913535544, and +351930478387.
# GEOTRAVEL_WHATSAPP_PILOT_PHONE_SUBSTRINGS=
# Bookings list: full catalog + amber highlight for rows from last “Sync changes” (updated_from pull). Default on.
# GEOTRAVEL_BOOKINGS_INCREMENTAL=1
# GEOTRAVEL_BOOKINGS_FULL_FETCH=1
# First watermark when none stored yet (ISO-8601). Default: last 24h on first load.
# GEOTRAVEL_BOOKINGS_INITIAL_UPDATED_FROM=2026-01-01T00:00:00.000Z
# E.164 for admin “Test welcome” on /admin/bookings (defaults to +351913535544).
# GEOTRAVEL_TEST_WELCOME_E164=+351913535544

# Stub CRM / ingestion
INGEST_SECRET=change-me-in-production

# CRM write-back: stub (default) or tg4travel (TG4 Travel Partners API)
# API docs: https://webhook.backoffice.tg4travel.com/index.html#/
CRM_MODE=stub
TG4TRAVEL_API_BASE_URL=https://webhook.backoffice.tg4travel.com/api
# Single static Bearer token provided by TG4Travel/Activ Global — no OAuth exchange needed.
TG4TRAVEL_BEARER_TOKEN=

# Meta WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Webhook callback URL (Meta dashboard): {NEXT_PUBLIC_APP_URL}/api/webhooks/whatsapp
# Inbound WhatsApp: run extraction + auto-reply before webhook 200 OK (default on). Set false only if your host supports Next after() reliably.
# WHATSAPP_WEBHOOK_AWAIT_PROCESSING=false
WHATSAPP_GRAPH_API_VERSION=v25.0
# Graph sends to …/{PHONE_NUMBER_ID}/messages — not the same as WHATSAPP_BUSINESS_ACCOUNT_ID.
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (Meta dashboard) — optional; not required by current app code.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# System User permanent token or temporary token from Graph API Explorer (keep secret).
# Temporary tokens expire (~24h); "Authentication Error" from Graph means regenerate or use a long-lived/System User token with whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=
# GET verify + optional POST signature check (recommended in production).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Default language for template sends (e.g. hello_world → en_US).
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en_US
# Admin pilot "WhatsApp" buttons: lifecycle phases map 1:1 to Meta templates (welcome_1, welcome_2, data, canceled, satisfaction).
# Language: en for non-PT phones; pt_PT when passenger phone normalizes to +351 (Portuguese national 9-digit included).
# Run npm run whatsapp:list-templates — only approved name+language rows work on WHATSAPP_BUSINESS_ACCOUNT_ID.
# Optional: WHATSAPP_META_TEMPLATE_WELCOME_1=alias_name — per-phase Meta name override
# Optional: WHATSAPP_LIFECYCLE_FALLBACK_TEMPLATE=booking_confirmation — force every phase to one template (dev only)
# Legacy single-template override (optional):
# WHATSAPP_BOOKING_CONFIRM_TEMPLATE_NAME=booking_confirmation
# WHATSAPP_BOOKING_CONFIRM_TEMPLATE_LANGUAGE=en
# When "false", a failed WhatsApp send is not retried via Infobip SMS (WhatsApp-only while fixing tokens/templates). Omit for default (fallback on).
# WHATSAPP_SMS_FALLBACK_AFTER_FAILURE=false
# If Meta returns 131005 Access denied (OAuthException), the token lacks WhatsApp scopes or is not assigned to this WABA/phone — use a System User token with whatsapp_business_messaging + whatsapp_business_management and assign assets in Business Settings. See https://developers.facebook.com/tools/debug/accesstoken/
# Optional: E.164 without + for scripts/whatsapp-smoke.ts (e.g. 351930478387).
WHATSAPP_TEST_TO_E164=

# Infobip SMS — https://www.infobip.com/docs (SMS: POST /sms/3/messages)
# Base URL from Infobip portal (e.g. https://xxxx.api.infobip.com or xxxx.api.infobip.com).
INFOBIP_BASE_URL=
# API key with SMS send scope; header: Authorization: App <key>
INFOBIP_API_KEY=
# Purchased PT number (digits or E.164). Example: 351923250271 or +351923250271
INFOBIP_SMS_SENDER=
# Alias for INFOBIP_SMS_SENDER
# INFOBIP_SMS_NUMBER=351923250271
# Reference only (portal number id); sending uses INFOBIP_SMS_SENDER digits.
# INFOBIP_SMS_NUMBER_ID=5A8FA1DE61F37DF29AA8D4A8795C20A3
# Inbound SMS (MO): no separate “inbound subscription product” to buy — you pay per MO segment.
# Infobip default on numbers is “Follow subscription”. Without a subscription, MO stays in logs only.
# Pick ONE setup (A is simplest):
# A) Number override: Channels and Numbers → +351923250271 → SMS → Default → Forward to HTTP
#    POST https://geotravel-eta.vercel.app/api/webhooks/infobip/sms — format MO_JSON_2
#    (Infobip rejects localhost / http-only — do not paste http://localhost:3000/...)
# B) Subscriptions: Developer Tools → Subscriptions Management → create subscription
#    Event: Inbound message (INBOUND_MESSAGE), channel SMS, format MO_JSON_2
#    Notification profile webhook: https://your-app.vercel.app/api/webhooks/infobip/sms
#    Number SMS default: Follow subscription (must match that subscription)
# Test: curl https://your-app.vercel.app/api/webhooks/infobip/sms (GET → {"ok":true})
# Infobip MO webhook (public https). Use this in the portal even when NEXT_PUBLIC_APP_URL is localhost for dev.
# INFOBIP_INBOUND_WEBHOOK_URL=https://geotravel-eta.vercel.app/api/webhooks/infobip/sms
# npm run infobip:inbound-check — probes webhook + local AI pipeline
# npm run infobip:setup-inbound — tries API HTTP forward (needs INFOBIP_SMS_NUMBER_ID)
# Default: wait for AI reply before webhook 200 (same as WhatsApp). Set false only on Pro with reliable after().
# INFOBIP_WEBHOOK_AWAIT_PROCESSING=true
# Optional: delivery reports for outbound SMS
# Optional delivery reports — must be public https (not localhost)
# INFOBIP_SMS_NOTIFY_URL=https://geotravel-eta.vercel.app/api/webhooks/infobip/sms/delivery
# Smoke scripts always send to 351966915976 only (see sms-test-destination.ts).
# INFOBIP_TEST_TO_E164=351966915976
# Preferred outbound for admin lifecycle buttons: whatsapp (default) or sms
# GEOTRAVEL_BOOKING_CONFIRM_PREFERRED_CHANNEL=whatsapp

# AI (OpenAI API — https://developers.openai.com/api/docs/models/gpt-5.5)
OPENAI_API_KEY=
# Chat model for extraction, language detection, and WhatsApp replies (default gpt-5.5).
# OPENAI_MODEL=gpt-5.5
# Estimated USD for /admin/quality consumption (override to match your invoice).
# OPENAI_USD_PER_1M_INPUT_TOKENS=2.5
# OPENAI_USD_PER_1M_OUTPUT_TOKENS=10
# META_WHATSAPP_USD_PER_TEMPLATE=0.065
# META_WHATSAPP_USD_PER_TEXT_MESSAGE=0.04
# INFOBIP_SMS_USD_PER_SEGMENT=0.085
# When inbound WhatsApp/SMS arrives while orchestration_state=needs_human, send an automatic acknowledgment.
# Uses OpenAI when OPENAI_API_KEY is set; otherwise a short canned message. Set to false to disable.
# AI_ASSISTANT_AUTO_REPLY_ON_NEEDS_HUMAN=true
# Default country code for matching national numbers (Geotravel / WhatsApp), e.g. 351 for Portugal.
# DEFAULT_PHONE_COUNTRY_CODE=351
# AI conversation on WhatsApp + SMS (template-aware replies, naturalize, catch-all). Set false to disable.
# MESSAGING_AI_CONVERSATION=true
# Legacy alias (still read if MESSAGING_AI_CONVERSATION is unset):
# WHATSAPP_AI_CONVERSATION=true

# Scheduling (Vercel Cron sends this header)
CRON_SECRET=

# Lifecycle automation (Inngest cron ~5m): pilot 966915976 only. Sequence per case:
# welcome_1 (>72h) or welcome_2 (48–72h) → data (≤48h before pickup) → satisfaction (24h after dropoff, or 1 month after pickup if no dropoff); canceled anytime.
# GEOTRAVEL_WHATSAPP_LIFECYCLE_AUTOMATION=true
# Hours after dropoff before satisfaction when dropoff_date_time is on the booking (default 24).
# GEOTRAVEL_WHATSAPP_SATISFACTION_DELAY_HOURS=24
# Calendar months after pickup for satisfaction when the API has no dropoff time (default 1).
# GEOTRAVEL_SATISFACTION_MONTHS_AFTER_PICKUP=1

# Inngest — https://www.inngest.com/docs/getting-started/nextjs-quick-start
# Local: `npm run inngest:dev` (no keys required; optional INNGEST_DEV=1).
# Production: one key only for cron/serve — Signing key from app.inngest.com → Manage → Signing key.
INNGEST_SIGNING_KEY=
# Only if you call inngest.send() from your app (not needed for the bookings sync cron).
# INNGEST_EVENT_KEY=

# App URL for webhooks (production / ngrok)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown on /legal/* pages for privacy & data-deletion requests (Meta expects a reachable process).
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# Quiet hours (24h local server TZ by default)
QUIET_HOURS_START_HOUR=22
QUIET_HOURS_END_HOUR=7
MAX_OUTBOUND_ATTEMPTS=5
RETRY_BASE_MINUTES=120
